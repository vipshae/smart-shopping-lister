{
  "extends": "$app/tsconfig",
  "include": ["src", "tests", "*.js"],
  "exclude": ["src/service-worker", "node_modules"],
  "compilerOptions": {
    "types": ["$app/types", "node"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true
  }
}
