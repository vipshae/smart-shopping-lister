    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/sveltekit": "^1.11.3",
    "mongoose": "^9.10.3",
    "zod": "^4.6.5"
