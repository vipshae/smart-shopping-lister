    "postcss-load-config": "6.0.1",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.49.1",
    "svelte-check": "4.3.5",
    "svrollbar": "^0.12.0",
    "tailwindcss": "4.1.18",
    "tslib": "^2.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@auth/sveltekit": "^1.11.1",
